# Copy to .env (same folder) and fill in. No secrets are needed except the tunnel token.

# Public host name the AI clients reach (no https://, no path)
MCP_DOMAIN=mcp.example.com

# ServiceDesk Plus Cloud and Zoho data centre (EU example)
SDP_BASE_URL=https://sdpondemand.manageengine.eu
SDP_PORTAL=itdesk
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu

# Client ID of the shared Zoho "server-based" client (not secret; the secret stays in the AI clients)
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Who may use the server — for a test, just yourself
ALLOWED_USERS=you@example.com
#ALLOWED_EMAIL_DOMAINS=example.com

SDP_TIMEZONE=Europe/Zurich
#SDP_STREAM_FIELD=udf_char1
#SDP_TASK_TEMPLATES={"<project id>":"<template name>"}

# Server port on the Docker host, for a reverse proxy you already run (no profile)
#MCP_BIND=192.168.1.20      # this host's LAN address; default 127.0.0.1
#MCP_HOST_PORT=18080        # default 8080
#TRUST_PROXY_HOPS=1         # 2 if e.g. Cloudflare's proxy sits in front of your reverse proxy

# Only for: docker compose --profile tunnel up -d
#CLOUDFLARE_TUNNEL_TOKEN=
