# ---------------------------------------------------------------------------
# servicedesk-projects-mcp — configuration
# Copy to ".env" in the folder that contains README.md (or inside dist/).
# Never commit .env: it holds your personal Zoho token.
# ---------------------------------------------------------------------------

# ServiceDesk Plus Cloud base URL: your custom domain, or the data-centre URL
#   US https://sdpondemand.manageengine.com   EU https://sdpondemand.manageengine.eu
#   IN https://sdpondemand.manageengine.in    (other data centres: see ManageEngine's API docs)
SDP_BASE_URL=https://sdpondemand.manageengine.eu

# Portal name, as in https://<domain>/app/<portal>/...  (often "itdesk")
SDP_PORTAL=itdesk

# Zoho accounts server of the SAME data centre
#   US https://accounts.zoho.com   EU https://accounts.zoho.eu
#   IN https://accounts.zoho.in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu

# Zoho "Self Client" (see README, step 3)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Projects where create/update is allowed: comma-separated project ids, or * for all.
# Empty = the server is read-only. Find ids with the sdp_list_projects tool.
SDP_WRITE_PROJECT_IDS=

# Optional: one JSON line per write operation
# SDP_AUDIT_LOG=C:\Users\you\mcp\servicedesk-projects-mcp\audit.jsonl

# Timezone used to interpret and display dates (IANA name). Default: UTC
SDP_TIMEZONE=Europe/Zurich

# Task template used when creating tasks. Default: Default Task
# SDP_DEFAULT_TASK_TEMPLATE=Default Task

# Optional: a task custom field (udf_*) exposed to Claude as "stream"
# (e.g. a workstream picklist). Leave unset to disable.
# SDP_STREAM_FIELD=udf_char1
